[Desktop Entry]
Type=Application
Encoding=UTF-8
Name=Aseprite
GenericName=Sprite Editor
Comment=Animated sprite editor & pixel art tool
Icon={{ target_home }}/.local/share/aseprite/data/icons/ase64.png
Categories=Graphics;2DGraphics;RasterGraphics;
Exec={{ target_home }}/.local/share/aseprite/aseprite %U
TryExec={{ target_home }}/.local/share/aseprite/aseprite
Terminal=false
StartupNotify=false
StartupWMClass=allegro
MimeType=image/bmp;image/gif;image/jpeg;image/png;image/x-pcx;image/x-tga;image/vnd.microsoft.icon;video/x-flic;image/webp;image/x-aseprite;
EOF